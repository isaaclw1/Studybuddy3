<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ResourceUploadActivity">

    <EditText
        android:id="@+id/resourceNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Resource Name" />

    <EditText
        android:id="@+id/resourceDescriptionInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Description"
        android:inputType="textMultiLine" />

    <EditText
        android:id="@+id/resourceCategoryInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Category (e.g., Lecture Notes, Practice Exams)" />

    <Button
        android:id="@+id/chooseFileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose PDF File" />

    <TextView
        android:id="@+id/chosenFileText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No file chosen"
        android:paddingTop="8dp" />

    <Button
        android:id="@+id/uploadResourceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload Resource" />
</LinearLayout>
